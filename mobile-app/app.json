{
  "expo": {
    "name": "Cognitive Inbox",
    "slug": "cognitive-inbox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paulinechi.cognitiveinbox",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111827"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.paulinechi.cognitiveinbox",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Cognitive Inbox to access your microphone for voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Cognitive Inbox to access your camera for visual notes.",
          "photosPermission": "Allow Cognitive Inbox to access your photos."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "8ae661d7-9225-4e12-bffa-298c003964f8"
      }
    }
  }
}
