{
  "buildCommand": "expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "expo",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cognitive-inbox-kz8e.vercel.app/:path*"
    },
    { "source": "/:path*", "destination": "/" }
  ]
}
