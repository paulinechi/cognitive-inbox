PROJECT_NAME="Cognitive Inbox API"
VERSION="0.1.0"

# Use a hosted database in production (SQLite is ephemeral on Vercel)
DATABASE_URL="sqlite:///./cognitive_inbox.db"

# Use a JSON array string for CORS (replace with your Vercel web URL)
BACKEND_CORS_ORIGINS='["http://localhost:19006","http://localhost:3000","https://your-vercel-web-url"]'

# Optional AI settings
GOOGLE_API_KEY=""
GEMINI_MODEL_NAME="gemini-flash-lite-latest"

# Auth — REQUIRED in production. Generate with: openssl rand -hex 32
# Without it, tokens are signed with an ephemeral key and expire on restart.
SECRET_KEY=""
# Token lifetime in minutes (default: 30 days)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Upload limits (MB)
MAX_UPLOAD_MB=20
MAX_IMPORT_MB=50
